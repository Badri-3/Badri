<p local-id=3D"36f82446-c8cf-4878-8756-ce82f83063f2">&lt; 12 hours&nbsp;</p=
>
</td>
<td data-highlight-colour=3D"#FFFFFF" data-local-id=3D"16457c11-1a39-4794-a=
989-3f333b0c04aa" class=3D"confluenceTd">
<p local-id=3D"28f63bc5-7faa-4fc3-8ae3-a1a96efb0199">&lt; 48 hours&nbsp;</p=
>
